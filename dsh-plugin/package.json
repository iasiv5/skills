{
  "name": "@iasiv5/dsh-skills",
  "version": "1.0.3",
  "description": "iasi 的 Agent skills 合集 DSH 插件：以 bundled skill 方式加载，免拷贝进 skills 目录。作者自用，不推广。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "agent-skills"
  ],
  "homepage": "https://github.com/iasiv5/skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/skills.git",
    "directory": "dsh-plugin"
  },
  "license": "SEE LICENSE IN NOTICE.md",
  "author": "iasi",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "skills-manifest.json",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "NOTICE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/provider.test.mjs"
  },
  "devDependencies": {
    "yaml": "^2.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
